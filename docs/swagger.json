                    }
                },
                "pagination": {
                    "$ref": "#/definitions/http.AdminPaginationResponse"
                }
            }
        },
        "http.AdminPaginationResponse": {
            "type": "object",
            "properties": {
                "page": {
                    "type": "integer"
                },
                "page_size": {
                    "type": "integer"
                },
                "total_count": {
                    "type": "integer"
                },
                "total_pages": {
                    "type": "integer"
                }
            }
        },
        "http.ContentResponse": {
            "type": "object",
            "properties": {
                "caption": {
                    "type": "string"
                },
                "created_at": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "is_hidden": {
                    "type": "boolean"
                },
                "link": {
                    "type": "string"
                },
                "ocr_text": {
                    "type": "string"
                },
                "rank": {
                    "type": "number"
                },
                "text_data": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                },
                "type": {
                    "$ref": "#/definitions/domain.ContentType"
                },
                "updated_at": {
                    "type": "string"
                }
